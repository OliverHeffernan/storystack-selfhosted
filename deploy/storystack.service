[Unit]
Description=StoryStack production backend
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/ollieh/Documents/storystack-selfhosted/app/server
EnvironmentFile=/home/ollieh/Documents/storystack-selfhosted/config/runtime.env
ExecStart=/usr/bin/node /home/ollieh/Documents/storystack-selfhosted/app/server/build/index.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
